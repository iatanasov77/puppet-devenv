<VirtualHost *:443>
    ServerName <%= @hostName %>

    SSLEngine on
    SSLCertificateFile <%= @certFile %>
    SSLCertificateKeyFile <%= @certKey %>

    # Required modules: proxy, proxy_http, proxy_http2, proxy_wstunnel
    ProxyPreserveHost On
    
    # Maintain HTTP/2 for Server-Sent Events (SSE) streaming
    ProtocolsHonorOrder On
    Protocols h2 http/1.1

    # Proxy requests for Mercure's endpoint (.well-known/mercure or custom path)
    # Adjust http://<%= @mercure['proxy'] %>:<%= @mercure['httpPort'] %>/ to match your Mercure container/service port
    SSLProxyEngine on
    ProxyPass / http://<%= @mercure['proxy'] %>:<%= @mercure['httpPort'] %>/
    ProxyPassReverse / http://<%= @mercure['proxy'] %>:<%= @mercure['httpPort'] %>/
    
    ErrorLog /var/www/<%= @hostName %>/apache.error.log
    CustomLog /var/www/<%= @hostName %>/apache.access.log common
    
    SetEnv proxy-initial-not-pooled 1
</VirtualHost>