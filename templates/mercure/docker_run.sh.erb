#! /bin/bash

/usr/bin/docker container inspect mercure 2> /dev/null || /usr/bin/docker run -d --name mercure --privileged \
  -p <%= @mercure['httpPort'] %>:80 \
  -p <%= @mercure['httpsPort'] %>:443 \
  -e SERVER_NAME=':80' \
  -e MERCURE_PUBLISHER_JWT_KEY='<%= @mercure['jwtSecret'] %>' \
  -e MERCURE_SUBSCRIBER_JWT_KEY='<%= @mercure['jwtSecret'] %>' \
  -e MERCURE_EXTRA_DIRECTIVES='anonymous
cors_origins *
playground
debugger' \
  dunglas/mercure:v<%= @config['version'] %>
