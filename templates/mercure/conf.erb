# Learn how to configure the Mercure.rocks Hub on https://mercure.rocks/docs/hub/config
{
    http_port <%= @mercure['httpPort'] %>
    https_port <%= @mercure['httpsPort'] %>
}

#<%= @mercure['host'] %> {
<%= @hostIp %> {
    log {
        output file /var/log/mercure.log {
            roll_size 3MiB
            roll_keep 5
            roll_keep_for 48h
        }
        format console
    }
    
    mercure {
        protocol_version_compatibility 8
        
        publisher_jwt "<%= @mercure['jwtSecret'] %>"
        subscriber_jwt "<%= @mercure['jwtSecret'] %>"
        
        #cors_origins <%= @mercure['cors_origins'] %>
        cors_origins *
        publish_origins *
        
        anonymous
        subscriptions
        playground
        debugger
    }
    
    encode zstd gzip
    respond /healthz 200
    respond "Not Found" 404
}
