# Learn how to configure the Mercure.rocks Hub on https://mercure.rocks/docs/hub/config
{
    http_port 2019
    https_port 3000
    auto_https disable_redirects
    order mercure after encode
}

https://127.0.0.1:<%= @mercure['port'] %> {
    log {
        output file /var/log/mercure.log {
            roll_size 3MiB
            roll_keep 5
            roll_keep_for 48h
        }
        format console
    }
    
    mercure {
        protocol_version_compatibility 8
        
        publisher_jwt "<%= @config['mercure']['jwtSecret'] %>"
        subscriber_jwt "<%= @config['mercure']['jwtSecret'] %>"
        
        #cors_origins <%= @config['mercure']['cors_origins'] %>
        cors_origins *
        publish_origins *
        
        anonymous
        subscriptions
    }
    
    encode zstd gzip
    respond /healthz 200
    respond "Not Found" 404
}
